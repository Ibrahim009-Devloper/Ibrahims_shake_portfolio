# SUPABASE_URL: URL of the Supabase project
SUPABASE_URL=https://voixkvyylglpomahowrl.supabase.co

# SUPABASE_PUBLISHABLE_KEY / SUPABASE_ANON_KEY: Supabase public publishable/anon key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_OAARPz-uSl72W8u3Fd6b6A_23fKup1o
SUPABASE_ANON_KEY=

# SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY: Supabase secret service_role key (secured on backend)
SUPABASE_SECRET_KEY=sb_secret_C95CoEgRV8x6SSMJRmYpCg_ZeEeN27E

# SUPABASE_JWKS_URL: Supabase Auth JWKS endpoint for token validation
SUPABASE_JWKS_URL=https://voixkvyylglpomahowrl.supabase.co/auth/v1/.well-known/jwks.json

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

